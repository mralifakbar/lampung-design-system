{
  "version": "0.1.1",
  "slug": "pagination",
  "title": "Pagination",
  "group": "Navigation",
  "order": 6,
  "summary": {
    "en": "Numbered page buttons under a long list or table. Show the first page, the last page and the neighbors of the current one; gaps become an ellipsis.",
    "id": "Tombol nomor halaman di bawah daftar atau tabel yang panjang. Tampilkan halaman pertama, halaman terakhir, dan tetangga halaman saat ini; celah di antaranya menjadi elipsis."
  },
  "titleId": "Pagination",
  "react": false,
  "examples": {
    "en": [
      {
        "title": "Under a table",
        "desc": "Page 5 of 12: first, last and the neighbors of the current page, with gaps between.",
        "html": "<nav class=\"cluster\" style=\"justify-content: space-between;\" aria-label=\"Pagination\">\n  <span class=\"section__sub\">Page 5 of 12</span>\n  <div class=\"pager\">\n    <button class=\"pager__btn\" aria-label=\"Previous page\"><span class=\"ic\" aria-hidden=\"true\">chevron_left</span></button>\n    <button class=\"pager__btn\" aria-label=\"Page 1\">1</button>\n    <span class=\"pager__gap\" aria-hidden=\"true\">…</span>\n    <button class=\"pager__btn\" aria-label=\"Page 4\">4</button>\n    <button class=\"pager__btn\" aria-label=\"Page 5\" aria-current=\"page\">5</button>\n    <button class=\"pager__btn\" aria-label=\"Page 6\">6</button>\n    <span class=\"pager__gap\" aria-hidden=\"true\">…</span>\n    <button class=\"pager__btn\" aria-label=\"Page 12\">12</button>\n    <button class=\"pager__btn\" aria-label=\"Next page\"><span class=\"ic\" aria-hidden=\"true\">chevron_right</span></button>\n  </div>\n</nav>"
      },
      {
        "title": "First page",
        "desc": "Previous is disabled on page 1; with few pages there are no gaps.",
        "html": "<nav aria-label=\"Pagination\">\n  <div class=\"pager\">\n    <button class=\"pager__btn\" aria-label=\"Previous page\" disabled><span class=\"ic\" aria-hidden=\"true\">chevron_left</span></button>\n    <button class=\"pager__btn\" aria-label=\"Page 1\" aria-current=\"page\">1</button>\n    <button class=\"pager__btn\" aria-label=\"Page 2\">2</button>\n    <button class=\"pager__btn\" aria-label=\"Page 3\">3</button>\n    <button class=\"pager__btn\" aria-label=\"Next page\"><span class=\"ic\" aria-hidden=\"true\">chevron_right</span></button>\n  </div>\n</nav>"
      }
    ],
    "id": [
      {
        "title": "Di bawah tabel",
        "desc": "Halaman 5 dari 12: pertama, terakhir, dan tetangga halaman saat ini, dengan celah di antaranya.",
        "html": "<nav class=\"cluster\" style=\"justify-content: space-between;\" aria-label=\"Paginasi\">\n  <span class=\"section__sub\">Halaman 5 dari 12</span>\n  <div class=\"pager\">\n    <button class=\"pager__btn\" aria-label=\"Halaman sebelumnya\"><span class=\"ic\" aria-hidden=\"true\">chevron_left</span></button>\n    <button class=\"pager__btn\" aria-label=\"Halaman 1\">1</button>\n    <span class=\"pager__gap\" aria-hidden=\"true\">…</span>\n    <button class=\"pager__btn\" aria-label=\"Halaman 4\">4</button>\n    <button class=\"pager__btn\" aria-label=\"Halaman 5\" aria-current=\"page\">5</button>\n    <button class=\"pager__btn\" aria-label=\"Halaman 6\">6</button>\n    <span class=\"pager__gap\" aria-hidden=\"true\">…</span>\n    <button class=\"pager__btn\" aria-label=\"Halaman 12\">12</button>\n    <button class=\"pager__btn\" aria-label=\"Halaman berikutnya\"><span class=\"ic\" aria-hidden=\"true\">chevron_right</span></button>\n  </div>\n</nav>"
      },
      {
        "title": "Halaman pertama",
        "desc": "Tombol sebelumnya nonaktif di halaman 1; dengan sedikit halaman tidak ada celah.",
        "html": "<nav aria-label=\"Paginasi\">\n  <div class=\"pager\">\n    <button class=\"pager__btn\" aria-label=\"Halaman sebelumnya\" disabled><span class=\"ic\" aria-hidden=\"true\">chevron_left</span></button>\n    <button class=\"pager__btn\" aria-label=\"Halaman 1\" aria-current=\"page\">1</button>\n    <button class=\"pager__btn\" aria-label=\"Halaman 2\">2</button>\n    <button class=\"pager__btn\" aria-label=\"Halaman 3\">3</button>\n    <button class=\"pager__btn\" aria-label=\"Halaman berikutnya\"><span class=\"ic\" aria-hidden=\"true\">chevron_right</span></button>\n  </div>\n</nav>"
      }
    ]
  },
