  "title": "Context menu",
  "group": "Overlays",
  "order": 7,
  "summary": {
    "en": "A command menu that opens at the pointer on right-click, a long press on touch, or Shift+F10. A shortcut for commands that are also reachable another way.",
    "id": "Menu perintah yang terbuka di posisi pointer saat klik kanan, tekan lama di layar sentuh, atau Shift+F10. Pintasan untuk perintah yang juga bisa dicapai dengan cara lain."
  },
  "titleId": "Context menu",
  "react": false,
  "examples": {
    "en": [
      {
        "title": "Application files",
        "desc": "Right-click in the box (or press and hold on touch, or focus it and press Shift+F10).",
        "html": "<div class=\"card card--fill\" data-lds-contextmenu=\"cm-file\" tabindex=\"0\" aria-label=\"Domicile certificate, press Shift+F10 for actions\" style=\"position: relative; height: 220px; display: grid; place-items: center; text-align: center; user-select: none;\">\n  <span class=\"section__sub\"><span class=\"ic\" aria-hidden=\"true\">description</span> Surat keterangan domisili.pdf<br>Right-click for actions</span>\n  <div class=\"menu\" id=\"cm-file\" role=\"menu\" aria-label=\"Domicile certificate\" style=\"min-width: 200px;\">\n    <button class=\"menu__item\" role=\"menuitem\"><span class=\"ic\" aria-hidden=\"true\">visibility</span>Open</button>\n    <button class=\"menu__item\" role=\"menuitem\"><span class=\"ic\" aria-hidden=\"true\">content_copy</span>Copy link<kbd>⌘C</kbd></button>\n    <button class=\"menu__item\" role=\"menuitem\"><span class=\"ic\" aria-hidden=\"true\">edit</span>Rename</button>\n    <div class=\"menu__sep\"></div>\n    <button class=\"menu__item menu__item--danger\" role=\"menuitem\"><span class=\"ic\" aria-hidden=\"true\">delete</span>Move to trash</button>\n  </div>\n</div>",
        "code": "<div class=\"card card--fill\" data-lds-contextmenu=\"file-menu\" tabindex=\"0\" style=\"position: relative;\">\n  …\n  <div class=\"menu\" id=\"file-menu\" role=\"menu\" aria-label=\"Domicile certificate\">\n    <button class=\"menu__item\" role=\"menuitem\"><span class=\"ic\" aria-hidden=\"true\">visibility</span>Open</button>\n    <button class=\"menu__item\" role=\"menuitem\"><span class=\"ic\" aria-hidden=\"true\">edit</span>Rename</button>\n    <div class=\"menu__sep\"></div>\n    <button class=\"menu__item menu__item--danger\" role=\"menuitem\"><span class=\"ic\" aria-hidden=\"true\">delete</span>Move to trash</button>\n  </div>\n</div>"
      }
    ],
    "id": [
      {
        "title": "Berkas permohonan",
        "desc": "Klik kanan di dalam kotak (atau tekan lama di layar sentuh, atau fokuskan lalu tekan Shift+F10).",
        "html": "<div class=\"card card--fill\" data-lds-contextmenu=\"cm-file\" tabindex=\"0\" aria-label=\"Surat keterangan domisili, tekan Shift+F10 untuk aksi\" style=\"position: relative; height: 220px; display: grid; place-items: center; text-align: center; user-select: none;\">\n  <span class=\"section__sub\"><span class=\"ic\" aria-hidden=\"true\">description</span> Surat keterangan domisili.pdf<br>Klik kanan untuk aksi</span>\n  <div class=\"menu\" id=\"cm-file\" role=\"menu\" aria-label=\"Surat keterangan domisili\" style=\"min-width: 200px;\">\n    <button class=\"menu__item\" role=\"menuitem\"><span class=\"ic\" aria-hidden=\"true\">visibility</span>Buka</button>\n    <button class=\"menu__item\" role=\"menuitem\"><span class=\"ic\" aria-hidden=\"true\">content_copy</span>Salin tautan<kbd>⌘C</kbd></button>\n    <button class=\"menu__item\" role=\"menuitem\"><span class=\"ic\" aria-hidden=\"true\">edit</span>Ganti nama</button>\n    <div class=\"menu__sep\"></div>\n    <button class=\"menu__item menu__item--danger\" role=\"menuitem\"><span class=\"ic\" aria-hidden=\"true\">delete</span>Pindahkan ke sampah</button>\n  </div>\n</div>",
        "code": "<div class=\"card card--fill\" data-lds-contextmenu=\"file-menu\" tabindex=\"0\" style=\"position: relative;\">\n  …\n  <div class=\"menu\" id=\"file-menu\" role=\"menu\" aria-label=\"Surat keterangan domisili\">\n    <button class=\"menu__item\" role=\"menuitem\"><span class=\"ic\" aria-hidden=\"true\">visibility</span>Buka</button>\n    <button class=\"menu__item\" role=\"menuitem\"><span class=\"ic\" aria-hidden=\"true\">edit</span>Ganti nama</button>\n    <div class=\"menu__sep\"></div>\n    <button class=\"menu__item menu__item--danger\" role=\"menuitem\"><span class=\"ic\" aria-hidden=\"true\">delete</span>Pindahkan ke sampah</button>\n  </div>\n</div>"
      }
    ]
