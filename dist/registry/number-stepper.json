{
  "version": "0.2.0",
  "slug": "number-stepper",
  "title": "Number stepper",
  "group": "Inputs",
  "order": 6,
  "summary": {
    "en": "Minus and plus buttons around a small whole number whose digits roll to the new value. For counts people change by one or two, inside a known range.",
    "id": "Tombol minus dan plus di sekitar bilangan bulat kecil yang digitnya bergulir ke nilai baru. Untuk jumlah yang diubah orang satu atau dua, di dalam rentang yang diketahui."
  },
  "titleId": "Number stepper",
  "react": false,
  "examples": {
    "en": [
      {
        "title": "Seats to reserve",
        "desc": "Digits roll to the new value; the minus disables at the minimum and the plus at the maximum. Press quickly to watch the columns travel.",
        "html": "<div class=\"field\" style=\"max-width: 320px;\">\n  <span class=\"field__label\" id=\"ns-seat\">Seats to reserve</span>\n  <div class=\"stepper-field\" role=\"group\" aria-labelledby=\"ns-seat\" data-lds-stepper data-min=\"1\" data-max=\"40\" data-value=\"12\">\n    <button type=\"button\" aria-label=\"Fewer seats\"><span class=\"ic\" aria-hidden=\"true\">remove</span></button>\n    <span class=\"stepper-field__value\"><span class=\"roll\" aria-live=\"polite\"></span></span>\n    <button type=\"button\" aria-label=\"More seats\"><span class=\"ic\" aria-hidden=\"true\">add</span></button>\n  </div>\n  <span class=\"field__help\">1 to 40 seats per booking.</span>\n</div>"
      },
      {
        "title": "At the end of a list row",
        "desc": "A small count per line, such as attendees per session.",
        "html": "<div class=\"list\" style=\"max-width: 440px; width: 100%;\">\n  <div class=\"lrow\"><span class=\"lrow__body\"><span class=\"lrow__title\" id=\"ns-r1\">Saturday UMKM workshop, room A</span></span>\n    <div class=\"stepper-field\" role=\"group\" aria-labelledby=\"ns-r1\" data-lds-stepper data-min=\"0\" data-max=\"6\" data-value=\"2\">\n      <button type=\"button\" aria-label=\"One person fewer\"><span class=\"ic\" aria-hidden=\"true\">remove</span></button>\n      <span class=\"stepper-field__value\"><span class=\"roll\" aria-live=\"polite\"></span></span>\n      <button type=\"button\" aria-label=\"One person more\"><span class=\"ic\" aria-hidden=\"true\">add</span></button>\n    </div>\n  </div>\n</div>"
      }
    ],
    "id": [
      {
        "title": "Kursi yang dipesan",
        "desc": "Digit bergulir ke nilai baru; minus nonaktif di batas bawah dan plus di batas atas. Tekan cepat untuk melihat kolom digit bergerak.",
        "html": "<div class=\"field\" style=\"max-width: 320px;\">\n  <span class=\"field__label\" id=\"ns-seat\">Kursi yang dipesan</span>\n  <div class=\"stepper-field\" role=\"group\" aria-labelledby=\"ns-seat\" data-lds-stepper data-min=\"1\" data-max=\"40\" data-value=\"12\">\n    <button type=\"button\" aria-label=\"Kurangi kursi\"><span class=\"ic\" aria-hidden=\"true\">remove</span></button>\n    <span class=\"stepper-field__value\"><span class=\"roll\" aria-live=\"polite\"></span></span>\n    <button type=\"button\" aria-label=\"Tambah kursi\"><span class=\"ic\" aria-hidden=\"true\">add</span></button>\n  </div>\n  <span class=\"field__help\">1 sampai 40 kursi per pemesanan.</span>\n</div>"
      },
      {
        "title": "Di akhir baris daftar",
        "desc": "Jumlah kecil per baris, seperti peserta per sesi.",
        "html": "<div class=\"list\" style=\"max-width: 440px; width: 100%;\">\n  <div class=\"lrow\"><span class=\"lrow__body\"><span class=\"lrow__title\" id=\"ns-r1\">Penyuluhan UMKM hari Sabtu, ruang A</span></span>\n    <div class=\"stepper-field\" role=\"group\" aria-labelledby=\"ns-r1\" data-lds-stepper data-min=\"0\" data-max=\"6\" data-value=\"2\">\n      <button type=\"button\" aria-label=\"Kurangi satu orang\"><span class=\"ic\" aria-hidden=\"true\">remove</span></button>\n      <span class=\"stepper-field__value\"><span class=\"roll\" aria-live=\"polite\"></span></span>\n      <button type=\"button\" aria-label=\"Tambah satu orang\"><span class=\"ic\" aria-hidden=\"true\">add</span></button>\n    </div>\n  </div>\n</div>"
      }
    ]
  },
