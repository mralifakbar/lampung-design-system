      {
        "title": "Rate a course",
        "desc": "Hover to preview, click to set. From the keyboard, Tab to the stars and use the arrow keys.",
        "html": "<div class=\"field\" style=\"align-items: flex-start;\">\n  <span class=\"field__label\" id=\"rt-label\">How was Database Systems?</span>\n  <div class=\"stars\" role=\"radiogroup\" aria-labelledby=\"rt-label\" onclick=\"const s = event.target.closest('.star'); if (!s) return; const all = [...this.querySelectorAll('.star')], n = all.indexOf(s); all.forEach((b, i) => { b.classList.toggle('on', i <= n); b.classList.remove('preview'); b.setAttribute('aria-checked', String(i === n)); b.tabIndex = i === n ? 0 : -1; });\" onmouseover=\"const s = event.target.closest('.star'), all = [...this.querySelectorAll('.star')], n = s ? all.indexOf(s) : -1; all.forEach((b, i) => b.classList.toggle('preview', i <= n && !b.classList.contains('on')));\" onmouseleave=\"this.querySelectorAll('.star').forEach((b) => b.classList.remove('preview'))\" onkeydown=\"const all = [...this.querySelectorAll('.star')], i = all.indexOf(document.activeElement), d = { ArrowRight: 1, ArrowUp: 1, ArrowLeft: -1, ArrowDown: -1 }[event.key]; if (d === undefined || i < 0) return; event.preventDefault(); const n = all[Math.max(0, Math.min(all.length - 1, i + d))]; n.focus(); n.click();\"><button type=\"button\" class=\"star\" role=\"radio\" aria-checked=\"false\" tabindex=\"0\" aria-label=\"1 star\"><span class=\"ic\" aria-hidden=\"true\">star</span></button><button type=\"button\" class=\"star\" role=\"radio\" aria-checked=\"false\" tabindex=\"-1\" aria-label=\"2 stars\"><span class=\"ic\" aria-hidden=\"true\">star</span></button><button type=\"button\" class=\"star\" role=\"radio\" aria-checked=\"false\" tabindex=\"-1\" aria-label=\"3 stars\"><span class=\"ic\" aria-hidden=\"true\">star</span></button><button type=\"button\" class=\"star\" role=\"radio\" aria-checked=\"false\" tabindex=\"-1\" aria-label=\"4 stars\"><span class=\"ic\" aria-hidden=\"true\">star</span></button><button type=\"button\" class=\"star\" role=\"radio\" aria-checked=\"false\" tabindex=\"-1\" aria-label=\"5 stars\"><span class=\"ic\" aria-hidden=\"true\">star</span></button></div>\n</div>",
        "code": "<span class=\"field__label\" id=\"course-rating\">How was Database Systems?</span>\n<div class=\"stars\" role=\"radiogroup\" aria-labelledby=\"course-rating\">\n  <button type=\"button\" class=\"star on\" role=\"radio\" aria-checked=\"false\" tabindex=\"-1\" aria-label=\"1 star\"><span class=\"ic\" aria-hidden=\"true\">star</span></button>\n  <button type=\"button\" class=\"star on\" role=\"radio\" aria-checked=\"false\" tabindex=\"-1\" aria-label=\"2 stars\"><span class=\"ic\" aria-hidden=\"true\">star</span></button>\n  <button type=\"button\" class=\"star on\" role=\"radio\" aria-checked=\"true\" tabindex=\"0\" aria-label=\"3 stars\"><span class=\"ic\" aria-hidden=\"true\">star</span></button>\n  <button type=\"button\" class=\"star\" role=\"radio\" aria-checked=\"false\" tabindex=\"-1\" aria-label=\"4 stars\"><span class=\"ic\" aria-hidden=\"true\">star</span></button>\n  <button type=\"button\" class=\"star\" role=\"radio\" aria-checked=\"false\" tabindex=\"-1\" aria-label=\"5 stars\"><span class=\"ic\" aria-hidden=\"true\">star</span></button>\n</div>\n<!-- Your code: click sets .on up to the star and aria-checked on it; hover adds .preview; arrow keys move. -->"
