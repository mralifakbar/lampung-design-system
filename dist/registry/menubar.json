{
  "version": "0.1.1",
  "slug": "menubar",
  "title": "Menubar",
  "group": "Navigation",
  "order": 10,
  "summary": {
    "en": "A row of command menus (File, Edit, View) for a desktop-style editor. Each button opens a dropdown menu of commands with their shortcuts.",
    "id": "Barisan menu perintah (Berkas, Edit, Tampilan) untuk editor bergaya desktop. Setiap tombol membuka dropdown menu berisi perintah beserta pintasannya."
  },
  "titleId": "Menubar",
  "react": false,
  "examples": {
    "en": [
      {
        "title": "Announcement editor",
        "desc": "Click File or Edit; arrow keys move inside the open menu, Escape closes it and returns focus to the button.",
        "html": "<div class=\"menubar\" role=\"menubar\" aria-label=\"Announcement editor\" style=\"width: max-content;\">\n  <div style=\"position: relative;\">\n    <button class=\"menubar__btn\" role=\"menuitem\" aria-haspopup=\"menu\" aria-expanded=\"false\" data-lds-menu=\"mb-file\">File</button>\n    <div class=\"menu\" id=\"mb-file\" role=\"menu\" aria-label=\"File\" style=\"top: calc(100% + 8px); left: 0;\">\n      <button class=\"menu__item\" role=\"menuitem\">New announcement<kbd>⌘N</kbd></button>\n      <button class=\"menu__item\" role=\"menuitem\">Duplicate<kbd>⌘D</kbd></button>\n      <div class=\"menu__sep\"></div>\n      <button class=\"menu__item\" role=\"menuitem\">Export as PDF<kbd>⇧⌘E</kbd></button>\n    </div>\n  </div>\n  <div style=\"position: relative;\">\n    <button class=\"menubar__btn\" role=\"menuitem\" aria-haspopup=\"menu\" aria-expanded=\"false\" data-lds-menu=\"mb-edit\">Edit</button>\n    <div class=\"menu\" id=\"mb-edit\" role=\"menu\" aria-label=\"Edit\" style=\"top: calc(100% + 8px); left: 0;\">\n      <button class=\"menu__item\" role=\"menuitem\">Undo<kbd>⌘Z</kbd></button>\n      <button class=\"menu__item\" role=\"menuitem\">Redo<kbd>⇧⌘Z</kbd></button>\n      <button class=\"menu__item\" role=\"menuitem\">Find<kbd>⌘F</kbd></button>\n    </div>\n  </div>\n  <div style=\"position: relative;\">\n    <button class=\"menubar__btn\" role=\"menuitem\" aria-haspopup=\"menu\" aria-expanded=\"false\" data-lds-menu=\"mb-view\">View</button>\n    <div class=\"menu\" id=\"mb-view\" role=\"menu\" aria-label=\"View\" style=\"top: calc(100% + 8px); left: 0;\">\n      <button class=\"menu__item is-selected\" role=\"menuitemcheckbox\" aria-checked=\"true\">Show outline<span class=\"ic menu__check\" aria-hidden=\"true\">check</span></button>\n      <button class=\"menu__item\" role=\"menuitemcheckbox\" aria-checked=\"false\">Show officer notes</button>\n    </div>\n  </div>\n</div>"
      }
    ],
    "id": [
      {
        "title": "Editor pengumuman",
        "desc": "Klik Berkas atau Edit; tombol panah berpindah di dalam menu yang terbuka, Escape menutupnya dan mengembalikan fokus ke tombol.",
        "html": "<div class=\"menubar\" role=\"menubar\" aria-label=\"Editor pengumuman\" style=\"width: max-content;\">\n  <div style=\"position: relative;\">\n    <button class=\"menubar__btn\" role=\"menuitem\" aria-haspopup=\"menu\" aria-expanded=\"false\" data-lds-menu=\"mb-file\">Berkas</button>\n    <div class=\"menu\" id=\"mb-file\" role=\"menu\" aria-label=\"Berkas\" style=\"top: calc(100% + 8px); left: 0;\">\n      <button class=\"menu__item\" role=\"menuitem\">Pengumuman baru<kbd>⌘N</kbd></button>\n      <button class=\"menu__item\" role=\"menuitem\">Duplikat<kbd>⌘D</kbd></button>\n      <div class=\"menu__sep\"></div>\n      <button class=\"menu__item\" role=\"menuitem\">Ekspor sebagai PDF<kbd>⇧⌘E</kbd></button>\n    </div>\n  </div>\n  <div style=\"position: relative;\">\n    <button class=\"menubar__btn\" role=\"menuitem\" aria-haspopup=\"menu\" aria-expanded=\"false\" data-lds-menu=\"mb-edit\">Edit</button>\n    <div class=\"menu\" id=\"mb-edit\" role=\"menu\" aria-label=\"Edit\" style=\"top: calc(100% + 8px); left: 0;\">\n      <button class=\"menu__item\" role=\"menuitem\">Urungkan<kbd>⌘Z</kbd></button>\n      <button class=\"menu__item\" role=\"menuitem\">Ulangi<kbd>⇧⌘Z</kbd></button>\n      <button class=\"menu__item\" role=\"menuitem\">Cari<kbd>⌘F</kbd></button>\n    </div>\n  </div>\n  <div style=\"position: relative;\">\n    <button class=\"menubar__btn\" role=\"menuitem\" aria-haspopup=\"menu\" aria-expanded=\"false\" data-lds-menu=\"mb-view\">Tampilan</button>\n    <div class=\"menu\" id=\"mb-view\" role=\"menu\" aria-label=\"Tampilan\" style=\"top: calc(100% + 8px); left: 0;\">\n      <button class=\"menu__item is-selected\" role=\"menuitemcheckbox\" aria-checked=\"true\">Tampilkan kerangka<span class=\"ic menu__check\" aria-hidden=\"true\">check</span></button>\n      <button class=\"menu__item\" role=\"menuitemcheckbox\" aria-checked=\"false\">Tampilkan catatan petugas</button>\n    </div>\n  </div>\n</div>"
      }
    ]
  },
  "related": [
    "dropdown-menu",
    "command-palette",
    "kbd",
    "top-nav"
  ]
}
