path class=\"tick\" d=\"M2.5 7.4 L5.7 10.4 L11.5 3.8\"></path><path class=\"dash\" d=\"M3 7 L11 7\"></path></svg></span></label></td><td><label class=\"check\"><input type=\"checkbox\" aria-label=\"Push: Ringkasan mingguan\"><span class=\"check__box\" aria-hidden=\"true\"><svg viewBox=\"0 0 14 14\"><path class=\"tick\" d=\"M2.5 7.4 L5.7 10.4 L11.5 3.8\"></path><path class=\"dash\" d=\"M3 7 L11 7\"></path></svg></span></label></td></tr>\n    </tbody>\n  </table>\n</div>"
