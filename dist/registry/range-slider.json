{
  "version": "0.1.0",
  "slug": "range-slider",
  "title": "Range slider",
  "group": "Selection",
  "order": 7,
  "summary": {
    "en": "Two thumbs on one track for a minimum and a maximum, with the accent fill between them. The thumbs can never cross; each is a native range input.",
    "id": "Dua thumb pada satu lintasan untuk nilai minimum dan maksimum, dengan isian aksen di antaranya. Kedua thumb tidak pernah bisa bersilangan; masing-masing adalah input range bawaan."
  },
  "titleId": "Range slider",
  "react": false,
  "examples": {
    "en": [
      {
        "title": "Participant age",
        "desc": "Age range for a youth job training. Drag either thumb, or Tab to it and use the arrow keys. The lower thumb stops one step below the upper one.",
        "html": "<div class=\"field\" style=\"max-width: 420px; width: 100%;\">\n  <span class=\"field__label\">Participant age <span id=\"rs-credits\">16 to 21</span></span>\n  <div class=\"range\" data-lds-range oninput=\"const [lo, hi] = this.querySelectorAll('input'); document.getElementById('rs-credits').textContent = lo.value + ' to ' + hi.value;\">\n    <div class=\"range__track\"><div class=\"range__fill\"></div></div>\n    <input type=\"range\" min=\"12\" max=\"24\" value=\"16\" aria-label=\"Minimum age\">\n    <input type=\"range\" min=\"12\" max=\"24\" value=\"21\" aria-label=\"Maximum age\">\n  </div>\n</div>"
      },
      {
        "title": "Fee filter",
        "desc": "Filtering public halls by daily rental fee. Larger steps for money; the label shows formatted values.",
        "html": "<div class=\"field\" style=\"max-width: 420px; width: 100%;\">\n  <span class=\"field__label\">Daily rental fee <span id=\"rs-price\">Rp 50.000 to Rp 250.000</span></span>\n  <div class=\"range\" data-lds-range oninput=\"const [lo, hi] = this.querySelectorAll('input'), f = (v) => 'Rp ' + Number(v).toLocaleString('id-ID'); document.getElementById('rs-price').textContent = f(lo.value) + ' to ' + f(hi.value);\">\n    <div class=\"range__track\"><div class=\"range__fill\"></div></div>\n    <input type=\"range\" min=\"0\" max=\"500000\" step=\"25000\" value=\"50000\" aria-label=\"Minimum fee\">\n    <input type=\"range\" min=\"0\" max=\"500000\" step=\"25000\" value=\"250000\" aria-label=\"Maximum fee\">\n  </div>\n</div>"
      }
    ],
    "id": [
      {
        "title": "Usia peserta",
        "desc": "Rentang usia untuk pelatihan kerja pemuda. Seret salah satu thumb, atau Tab ke sana dan pakai tombol panah. Thumb bawah berhenti satu langkah di bawah thumb atas.",
        "html": "<div class=\"field\" style=\"max-width: 420px; width: 100%;\">\n  <span class=\"field__label\">Usia peserta <span id=\"rs-credits\">16 sampai 21</span></span>\n  <div class=\"range\" data-lds-range oninput=\"const [lo, hi] = this.querySelectorAll('input'); document.getElementById('rs-credits').textContent = lo.value + ' sampai ' + hi.value;\">\n    <div class=\"range__track\"><div class=\"range__fill\"></div></div>\n    <input type=\"range\" min=\"12\" max=\"24\" value=\"16\" aria-label=\"Usia minimum\">\n    <input type=\"range\" min=\"12\" max=\"24\" value=\"21\" aria-label=\"Usia maksimum\">\n  </div>\n</div>"
      },
      {
        "title": "Filter tarif",
        "desc": "Menyaring gedung serbaguna milik daerah menurut tarif sewa harian. Langkah lebih besar untuk uang; label menampilkan nilai yang sudah diformat.",
        "html": "<div class=\"field\" style=\"max-width: 420px; width: 100%;\">\n  <span class=\"field__label\">Tarif sewa harian <span id=\"rs-price\">Rp 50.000 sampai Rp 250.000</span></span>\n  <div class=\"range\" data-lds-range oninput=\"const [lo, hi] = this.querySelectorAll('input'), f = (v) => 'Rp ' + Number(v).toLocaleString('id-ID'); document.getElementById('rs-price').textContent = f(lo.value) + ' sampai ' + f(hi.value);\">\n    <div class=\"range__track\"><div class=\"range__fill\"></div></div>\n    <input type=\"range\" min=\"0\" max=\"500000\" step=\"25000\" value=\"50000\" aria-label=\"Tarif minimum\">\n    <input type=\"range\" min=\"0\" max=\"500000\" step=\"25000\" value=\"250000\" aria-label=\"Tarif maksimum\">\n  </div>\n</div>"
      }
    ]
  },
  "related": [
    "slider",
    "chips",
    "drawer",
