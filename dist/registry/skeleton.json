        "html": "<div class=\"list\" style=\"max-width: 420px;\" aria-busy=\"true\" aria-label=\"Loading courses\">\n  <div class=\"lrow\" aria-hidden=\"true\"><div class=\"skel\" style=\"width: 30px; height: 30px;\"></div><div class=\"lrow__body\"><div class=\"skel\" style=\"height: 12px; width: 60%;\"></div><div class=\"skel\" style=\"height: 10px; width: 35%; margin-top: 8px;\"></div></div></div>\n  <div class=\"lrow\" aria-hidden=\"true\"><div class=\"skel\" style=\"width: 30px; height: 30px;\"></div><div class=\"lrow__body\"><div class=\"skel\" style=\"height: 12px; width: 48%;\"></div><div class=\"skel\" style=\"height: 10px; width: 30%; margin-top: 8px;\"></div></div></div>\n  <div class=\"lrow\" aria-hidden=\"true\"><div class=\"skel\" style=\"width: 30px; height: 30px;\"></div><div class=\"lrow__body\"><div class=\"skel\" style=\"height: 12px; width: 66%;\"></div><div class=\"skel\" style=\"height: 10px; width: 40%; margin-top: 8px;\"></div></div></div>\n</div>"
      },
      {
        "title": "Profile header",
        "desc": "Circles for avatars, wider bars for headings.",
