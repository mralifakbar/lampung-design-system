    "id": [
      {
        "title": "Izin per peran",
        "desc": "Centang satu sel, atau centang area untuk satu kolom penuh: kotak area menampilkan campuran bila hanya sebagian yang aktif. Pemilik dikunci. Gulir kotaknya: header dan nama izin tetap di tempat.",
        "html": "<div class=\"matrix-box\" tabindex=\"0\" role=\"region\" aria-label=\"Izin per peran, bisa digulir\" style=\"--h: 360px;\">\n  <table class=\"matrix\" data-lds-matrix>\n    <caption class=\"sr-only\">Izin per peran</caption>\n    <thead><tr><th scope=\"col\">Izin</th><th scope=\"col\">Pemilik <span class=\"ic\" aria-label=\"Dikunci\">lock</span></th><th scope=\"col\">Admin</th><th scope=\"col\">Penyunting</th><th scope=\"col\">Pembaca</th></tr></thead>\n    <tbody>\n      <tr class=\"matrix__group\" data-group=\"people\"><th scope=\"rowgroup\">Anggota</th><td><label class=\"check\"><input type=\"checkbox\" data-lds-matrix-all aria-label=\"Semua izin Anggota untuk Pemilik\"><span class=\"check__box\" aria-hidden=\"true\"><svg viewBox=\"0 0 14 14\"><path class=\"tick\" d=\"M2.5 7.4 L5.7 10.4 L11.5 3.8\"></path><path class=\"dash\" d=\"M3 7 L11 7\"></path></svg></span></label></td><td><label class=\"check\"><input type=\"checkbox\" data-lds-matrix-all aria-label=\"Semua izin Anggota untuk Admin\"><span class=\"check__box\" aria-hidden=\"true\"><svg viewBox=\"0 0 14 14\"><path class=\"tick\" d=\"M2.5 7.4 L5.7 10.4 L11.5 3.8\"></path><path class=\"dash\" d=\"M3 7 L11 7\"></path></svg></span></label></td><td><label class=\"check\"><input type=\"checkbox\" data-lds-matrix-all aria-label=\"Semua izin Anggota untuk Penyunting\"><span class=\"check__box\" aria-hidden=\"true\"><svg viewBox=\"0 0 14 14\"><path class=\"tick\" d=\"M2.5 7.4 L5.7 10.4 L11.5 3.8\"></path><path class=\"dash\" d=\"M3 7 L11 7\"></path></svg></span></label></td><td><label class=\"check\"><input type=\"checkbox\" data-lds-matrix-all aria-label=\"Semua izin Anggota untuk Pembaca\"><span class=\"check__box\" aria-hidden=\"true\"><svg viewBox=\"0 0 14 14\"><path class=\"tick\" d=\"M2.5 7.4 L5.7 10.4 L11.5 3.8\"></path><path class=\"dash\" d=\"M3 7 L11 7\"></path></svg></span></label></td></tr>\n      <tr data-group=\"people\"><th scope=\"row\">Undang orang<span class=\"matrix__sub\">Kirim undangan lewat email</span></th><td><label class=\"check\"><input type=\"checkbox\" checked disabled aria-label=\"Pemilik: Undang orang\"><span class=\"check__box\" aria-hidden=\"true\"><svg viewBox=\"0 0 14 14\"><path class=\"tick\" d=\"M2.5 7.4 L5.7 10.4 L11.5 3.8\"></path><path class=\"dash\" d=\"M3 7 L11 7\"></path></svg></span></label></td><td><label class=\"check\"><input type=\"checkbox\" checked aria-label=\"Admin: Undang orang\"><span class=\"check__box\" aria-hidden=\"true\"><svg viewBox=\"0 0 14 14\"><path class=\"tick\" d=\"M2.5 7.4 L5.7 10.4 L11.5 3.8\"></path><path class=\"dash\" d=\"M3 7 L11 7\"></path></svg></span></label></td><td><label class=\"check\"><input type=\"checkbox\" aria-label=\"Penyunting: Undang orang\"><span class=\"check__box\" aria-hidden=\"true\"><svg viewBox=\"0 0 14 14\"><path class=\"tick\" d=\"M2.5 7.4 L5.7 10.4 L11.5 3.8\"></path><path class=\"dash\" d=\"M3 7 L11 7\"></path></svg></span></label></td><td><label class=\"check\"><input type=\"checkbox\" aria-label=\"Pembaca: Undang orang\"><span class=\"check__box\" aria-hidden=\"true\"><svg viewBox=\"0 0 14 14\"><path class=\"tick\" d=\"M2.5 7.4 L5.7 10.4 L11.5 3.8\"></path><path class=\"dash\" d=\"M3 7 L11 7\"></path></svg></span></label></td></tr>\n      <tr data-group=\"people\"><th scope=\"row\">Ubah peran<span class=\"matrix__sub\">Naikkan atau turunkan peran anggota</span></th><td><label class=\"check\"><input type=\"checkbox\" checked disabled aria-label=\"Pemilik: Ubah peran\"><span class=\"check__box\" aria-hidden=\"true\"><svg viewBox=\"0 0 14 14\"><path class=\"tick\" d=\"M2.5 7.4 L5.7 10.4 L11.5 3.8\"></path><path class=\"dash\" d=\"M3 7 L11 7\"></path></svg></span></label></td><td><label class=\"check\"><input type=\"checkbox\" checked aria-label=\"Admin: Ubah peran\"><span class=\"check__box\" aria-hidden=\"true\"><svg viewBox=\"0 0 14 14\"><path class=\"tick\" d=\"M2.5 7.4 L5.7 10.4 L11.5 3.8\"></path><path class=\"dash\" d=\"M3 7 L11 7\"></path></svg></span></label