{
  "version": "0.1.0",
  "slug": "button-group",
  "title": "Button group",
  "group": "Actions",
  "order": 4,
  "summary": {
    "en": "Two to four attached buttons in one outlined box, for separate actions on the same object (undo, redo, history). Each button does something; none of them stays selected.",
    "id": "Dua sampai empat tombol yang menyatu dalam satu kotak bergaris, untuk aksi terpisah pada objek yang sama (urungkan, ulangi, riwayat). Setiap tombol menjalankan sesuatu; tidak ada yang tetap terpilih."
  },
  "titleId": "Button group",
  "react": false,
  "examples": {
    "en": [
      {
        "title": "Edit history",
        "desc": "Three actions on the same document.",
        "html": "<div class=\"btn-group\" role=\"group\" aria-label=\"Edit history\">\n  <button class=\"btn btn--md\"><span class=\"ic\" aria-hidden=\"true\">undo</span>Undo</button>\n  <button class=\"btn btn--md\"><span class=\"ic\" aria-hidden=\"true\">redo</span>Redo</button>\n  <button class=\"btn btn--md\"><span class=\"ic\" aria-hidden=\"true\">history</span>History</button>\n</div>"
      },
      {
        "title": "Previous and next",
        "desc": "Stepping through files on an application review screen, next to the file count.",
        "html": "<div class=\"cluster\" style=\"--gap: 12px;\">\n  <span class=\"card__sub\" style=\"margin: 0;\">File 4 of 40</span>\n  <div class=\"btn-group\" role=\"group\" aria-label=\"File\">\n    <button class=\"btn btn--md\"><span class=\"ic\" aria-hidden=\"true\">chevron_left</span>Previous</button>\n    <button class=\"btn btn--md\">Next<span class=\"ic\" aria-hidden=\"true\">chevron_right</span></button>\n  </div>\n</div>"
      }
    ],
    "id": [
      {
        "title": "Riwayat suntingan",
        "desc": "Tiga aksi pada dokumen yang sama.",
        "html": "<div class=\"btn-group\" role=\"group\" aria-label=\"Riwayat suntingan\">\n  <button class=\"btn btn--md\"><span class=\"ic\" aria-hidden=\"true\">undo</span>Urungkan</button>\n  <button class=\"btn btn--md\"><span class=\"ic\" aria-hidden=\"true\">redo</span>Ulangi</button>\n  <button class=\"btn btn--md\"><span class=\"ic\" aria-hidden=\"true\">history</span>Riwayat</button>\n</div>"
      },
      {
        "title": "Sebelumnya dan berikutnya",
        "desc": "Menelusuri berkas di layar pemeriksaan permohonan, di samping jumlah berkas.",
        "html": "<div class=\"cluster\" style=\"--gap: 12px;\">\n  <span class=\"card__sub\" style=\"margin: 0;\">Berkas 4 dari 40</span>\n  <div class=\"btn-group\" role=\"group\" aria-label=\"Berkas\">\n    <button class=\"btn btn--md\"><span class=\"ic\" aria-hidden=\"true\">chevron_left</span>Sebelumnya</button>\n    <button class=\"btn btn--md\">Berikutnya<span class=\"ic\" aria-hidden=\"true\">chevron_right</span></button>\n  </div>\n</div>"
      }
    ]
  },
  "related": [
