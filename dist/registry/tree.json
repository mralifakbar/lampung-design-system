  "summary": {
    "en": "Nested rows that open and close: folders and files, units and lessons. Each parent is a button with `aria-expanded`; its children open on a spring.",
    "id": "Baris bertingkat yang bisa dibuka dan ditutup: folder dan berkas, bab dan subbab. Setiap induk adalah tombol dengan `aria-expanded`; anak-anaknya terbuka dengan spring."
  },
  "titleId": "Tree",
  "react": false,
  "examples": {
    "en": [
      {
        "title": "Course files",
        "desc": "Open and close the folders. The selected file is on the accent tint.",
        "html": "<nav class=\"tree\" aria-label=\"Course files\" style=\"max-width: 300px;\">\n  <button class=\"tree__row\" aria-expanded=\"true\" aria-controls=\"tk1\"><span class=\"ic tree__chev\" aria-hidden=\"true\">chevron_right</span><span class=\"ic\" aria-hidden=\"true\">folder_open</span>Week 1: introduction</button>\n  <div class=\"tree__kids is-open\" id=\"tk1\"><div>\n    <a class=\"tree__row is-selected\" href=\"#syllabus\" aria-current=\"page\"><span class=\"ic\" aria-hidden=\"true\">description</span>Syllabus</a>\n    <a class=\"tree__row\" href=\"#slides\"><span class=\"ic\" aria-hidden=\"true\">description</span>Lecture slides</a>\n  </div></div>\n  <button class=\"tree__row\" aria-expanded=\"false\" aria-controls=\"tk2\"><span class=\"ic tree__chev\" aria-hidden=\"true\">chevron_right</span><span class=\"ic\" aria-hidden=\"true\">folder</span>Week 2: sampling</button>\n  <div class=\"tree__kids\" id=\"tk2\"><div>\n    <a class=\"tree__row\" href=\"#reading\"><span class=\"ic\" aria-hidden=\"true\">description</span>Reading list</a>\n    <a class=\"tree__row\" href=\"#quiz\"><span class=\"ic\" aria-hidden=\"true\">assignment</span>Practice quiz</a>\n  </div></div>\n</nav>"
      }
    ],
    "id": [
