{
  "version": "0.1.1",
  "slug": "avatar",
  "title": "Avatar",
  "group": "Data display",
  "order": 6,
  "summary": {
    "en": "A circle with a person's initials on a tint, sized with `--size`. Initials until a real photo exists; never generated faces.",
    "id": "Lingkaran berisi inisial nama seseorang di atas warna tint, ukurannya diatur dengan `--size`. Pakai inisial sampai ada foto asli; jangan pernah wajah buatan."
  },
  "titleId": "Avatar",
  "react": false,
  "examples": {
    "en": [
      {
        "title": "Sizes and variants",
        "desc": "Set `--size`. Gray for non-members, square for groups, presence for online.",
        "html": "<div class=\"docs-row\" style=\"align-items: flex-end; gap: 14px;\">\n  <span class=\"avatar\" style=\"--size: 24px;\" aria-hidden=\"true\">AR</span>\n  <span class=\"avatar\" style=\"--size: 32px;\" aria-hidden=\"true\">AR</span>\n  <span class=\"avatar\" role=\"img\" aria-label=\"Ayu Rahma, online\">AR<span class=\"avatar__presence\"></span></span>\n  <span class=\"avatar avatar--gray\" style=\"--size: 56px;\" aria-hidden=\"true\">NS</span>\n  <span class=\"avatar avatar--sq\" style=\"--size: 56px;\" role=\"img\" aria-label=\"Karang taruna youth group\">KT</span>\n</div>"
      },
      {
        "title": "Stack",
        "desc": "Overlapping members with a \"+2\". Hover to fan them out.",
        "html": "<div class=\"docs-row\">\n  <div class=\"avatar-stack\" role=\"img\" aria-label=\"5 members: Ayu, Nadia, Dimas and 2 more\"><span class=\"avatar\" style=\"--i: 0;\">AR</span><span class=\"avatar avatar--gray\" style=\"--i: 1;\">NS</span><span class=\"avatar\" style=\"--i: 2;\">DP</span><span class=\"avatar avatar--gray\" style=\"--i: 3;\">+2</span></div>\n  <span class=\"card__sub\" style=\"margin: 0;\">5 members are editing</span>\n</div>"
      },
      {
        "title": "In a list row",
        "desc": "The name next to the avatar is the accessible name, so the avatar is hidden.",
        "html": "<div class=\"list\" style=\"max-width: 420px;\">\n  <div class=\"lrow\"><span class=\"avatar\" aria-hidden=\"true\">AR</span><div class=\"lrow__body\"><div class=\"lrow__title\">Ayu Rahma</div><div class=\"lrow__sub\">Head of RT 04</div></div></div>\n  <div class=\"lrow\"><span class=\"avatar avatar--gray\" aria-hidden=\"true\">BW</span><div class=\"lrow__body\"><div class=\"lrow__title\">Budi Wicaksono</div><div class=\"lrow__sub\">Visiting officer</div></div></div>\n</div>"
      }
    ],
    "id": [
      {
        "title": "Ukuran dan varian",
        "desc": "Atur `--size`. Abu-abu untuk bukan anggota, persegi untuk kelompok, presence untuk yang online.",
        "html": "<div class=\"docs-row\" style=\"align-items: flex-end; gap: 14px;\">\n  <span class=\"avatar\" style=\"--size: 24px;\" aria-hidden=\"true\">AR</span>\n  <span class=\"avatar\" style=\"--size: 32px;\" aria-hidden=\"true\">AR</span>\n  <span class=\"avatar\" role=\"img\" aria-label=\"Ayu Rahma, online\">AR<span class=\"avatar__presence\"></span></span>\n  <span class=\"avatar avatar--gray\" style=\"--size: 56px;\" aria-hidden=\"true\">NS</span>\n  <span class=\"avatar avatar--sq\" style=\"--size: 56px;\" role=\"img\" aria-label=\"Karang taruna\">KT</span>\n</div>"
      },
      {
        "title": "Tumpukan",
        "desc": "Anggota yang bertumpuk dengan \"+2\". Arahkan kursor untuk menyebarkannya.",
        "html": "<div class=\"docs-row\">\n  <div class=\"avatar-stack\" role=\"img\" aria-label=\"5 anggota: Ayu, Nadia, Dimas, dan 2 lainnya\"><span class=\"avatar\" style=\"--i: 0;\">AR</span><span class=\"avatar avatar--gray\" style=\"--i: 1;\">NS</span><span class=\"avatar\" style=\"--i: 2;\">DP</span><span class=\"avatar avatar--gray\" style=\"--i: 3;\">+2</span></div>\n  <span class=\"card__sub\" style=\"margin: 0;\">5 anggota sedang menyunting</span>\n</div>"
      },
      {
        "title": "Di baris daftar",
        "desc": "Nama di sebelah avatar menjadi nama aksesibelnya, jadi avatarnya disembunyikan.",
        "html": "<div class=\"list\" style=\"max-width: 420px;\">\n  <div class=\"lrow\"><span class=\"avatar\" aria-hidden=\"true\">AR</span><div class=\"lrow__body\"><div class=\"lrow__title\">Ayu Rahma</div><div class=\"lrow__sub\">Ketua RT 04</div></div></div>\n  <div class=\"lrow\"><span class=\"avatar avatar--gray\" aria-hidden=\"true\">BW</span><div class=\"lrow__body\"><div class=\"lrow__title\">Budi Wicaksono</div><div class=\"lrow__sub\">Petugas tamu</div></div></div>\n</div>"
      }
    ]
  },
