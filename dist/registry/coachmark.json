  "group": "Feedback",
  "order": 12,
  "summary": {
    "en": "An inverse card that points at one part of the interface with a short explanation, in a tour of at most three steps. Always skippable.",
    "id": "Card berwarna terbalik yang menunjuk satu bagian antarmuka dengan penjelasan singkat, dalam tur paling banyak tiga langkah. Selalu bisa dilewati."
  },
  "titleId": "Coachmark",
  "react": false,
  "examples": {
    "en": [
      {
        "title": "A three-step tour",
        "desc": "The card glides to the next target and the arrow follows. Press Next.",
        "html": "<div style=\"position: relative; min-height: 260px;\" id=\"cm\">\n  <div class=\"docs-row\">\n    <button class=\"btn btn--secondary btn--md is-lit\" data-step=\"0\"><span class=\"ic\" aria-hidden=\"true\">search</span>Search</button>\n    <button class=\"btn btn--secondary btn--md\" data-step=\"1\"><span class=\"ic\" aria-hidden=\"true\">filter_list</span>Filter</button>\n    <button class=\"btn btn--primary btn--md\" data-step=\"2\"><span class=\"ic\" aria-hidden=\"true\">add</span>New report</button>\n  </div>\n  <div class=\"coach\" role=\"dialog\" aria-labelledby=\"cm-t\" aria-describedby=\"cm-b\" style=\"top: 64px; left: 0;\">\n    <div class=\"coach__step\" id=\"cm-s\">Step 1 of 3</div>\n    <div class=\"coach__title\" id=\"cm-t\">Search every report</div>\n    <div class=\"coach__body\" id=\"cm-b\">Find a report by any word in it, not only the title.</div>\n    <div class=\"docs-row\" style=\"gap: 8px; margin-top: 14px; justify-content: flex-end;\">\n      <button class=\"btn btn--sm\" onclick=\"this.closest('.coach').hidden = true; document.querySelectorAll('#cm [data-step]').forEach((b) => b.classList.remove('is-lit'));\">Skip</button>\n      <button class=\"btn btn--sm is-primary\" onclick=\"const box = document.getElementById('cm'); const c = box.querySelector('.coach'); const n = Number(c.dataset.n || 0) + 1; const t = [['Search every report', 'Find a report by any word in it, not only the title.'], ['Filter by kecamatan', 'Show only the reports from one kecamatan or one week.'], ['Start a new report', 'It saves as you type, even offline.']]; if (n > 2) { c.hidden = true; box.querySelectorAll('[data-step]').forEach((b) => b.classList.remove('is-lit')); return; } c.dataset.n = n; const target = box.querySelector('[data-step=&quot;' + n + '&quot;]'); box.querySelectorAll('[data-step]').forEach((b) => b.classList.toggle('is-lit', b === target)); c.style.transform = 'translateX(' + Math.max(0, target.offsetLeft - 8) + 'px)'; c.style.setProperty('--arrow', Math.min(240, target.offsetWidth / 2 + 2) + 'px'); document.getElementById('cm-s').textContent = 'Step ' + (n + 1) + ' of 3'; document.getElementById('cm-t').textContent = t[n][0]; document.getElementById('cm-b').textContent = t[n][1]; if (n === 2) this.textContent = 'Done';\">Next</button>\n    </div>\n  </div>\n</div>",
        "code": "<div style=\"position: relative;\">\n  <button class=\"btn btn--secondary btn--md is-lit\" id=\"search-btn\">Search</button>\n  <div class=\"coach\" role=\"dialog\" aria-labelledby=\"coach-t\" aria-describedby=\"coach-b\" style=\"top: 64px; left: 0; --arrow: 40px;\">\n    <div class=\"coach__step\">Step 1 of 3</div>\n    <div class=\"coach__title\" id=\"coach-t\">Search every report</div>\n    <div class=\"coach__body\" id=\"coach-b\">Find a report by any word in it, not only the title.</div>\n    <div class=\"cluster\" style=\"margin-top: 14px; justify-content: flex-end;\">\n      <button class=\"btn btn--sm\">Skip</button>\n      <button class=\"btn btn--sm is-primary\">Next</button>\n    </div>\n  </div>\n</div>"
      },
      {
        "title": "A single pointer",
        "desc": "One step needs no counter; the only action is \"Got it\".",
        "html": "<div style=\"position: relative; min-height: 210px;\">\n  <button class=\"btn btn--gray btn--md is-lit\"><span class=\"ic\" aria-hidden=\"true\">download</span>Export</button>\n  <div class=\"coach\" role=\"dialog\" aria-labelledby=\"cm2-t\" style=\"top: 60px; left: 0; --arrow: 36px;\">\n    <div class=\"coach__title\" id=\"cm2-t\">Export retribusi data to a spreadsheet</div>\n    <div class=\"coach__body\">Every column you see is included, in the same order.</div>\n    <div class=\"docs-row\" style=\"margin-top: 14px; justify-content: flex-end;\"><button class=\"btn btn--sm is-primary\" onclick=\"this.closest('.coach').hidden = true; this.closest('.coach').parentElement.querySelector('.is-lit').classList.remove('is-lit');\">Got it</button></div>\n  </div>\n</div>"
      }
    ],
    "id": [
      {
        "title": "Tur tiga langkah",
        "desc": "Card meluncur ke target berikutnya dan panahnya mengikuti. Tekan Lanjut.",
        "html": "<div style=\"position: relative; min-height: 260px;\" id=\"cm\">\n  <div class=\"docs-row\">\n    <button class=\"btn btn--secondary btn--md is-lit\" data-step=\"0\"><span class=\"ic\" aria-hidden=\"true\">search</span>Cari</button>\n    <button class=\"btn btn--secondary btn--md\" data-step=\"1\"><span class=\"ic\" aria-hidden=\"true\">filter_list</span>Saring</button>\n    <button class=\"btn btn--primary btn--md\" data-step=\"2\"><span class=\"ic\" aria-hidden=\"true\">add</span>Laporan baru</button>\n  </div>\n  <div class=\"coach\" role=\"dialog\" aria-labelledby=\"cm-t\" aria-describedby=\"cm-b\" style=\"top: 64px; left: 0;\">\n    <div class=\"coach__step\" id=\"cm-s\">Langkah 1 dari 3</div>\n    <div class=\"coach__title\" id=\"cm-t\">Cari semua laporan</div>\n    <div class=\"coach__body\" id=\"cm-b\">Temukan laporan lewat kata apa pun di dalamnya, tidak hanya judulnya.</div>\n    <div class=\"docs-row\" style=\"gap: 8px; margin-top: 14px; justify-content: flex-end;\">\n      <button class=\"btn btn--sm\" onclick=\"this.closest('.coach').hidden = true; document.querySelectorAll('#cm [data-step]').forEach((b) => b.classList.remove('is-lit'));\">Lewati</button>\n      <button class=\"btn btn--sm is-primary\" onclick=\"const box = document.getElementById('cm'); const c = box.querySelector('.coach'); const n = Number(c.dataset.n || 0) + 1; const t = [['Cari semua laporan', 'Temukan laporan lewat kata apa pun di dalamnya, tidak hanya judulnya.'], ['Saring per kecamatan', 'Tampilkan hanya laporan dari satu kecamatan atau satu minggu.'], ['Buat laporan baru', 'Isian tersimpan saat Anda mengetik, bahkan saat offline.']]; if (n > 2) { c.hidden = true; box.querySelectorAll('[data-step]').forEach((b) => b.classList.remove('is-lit')); return; } c.dataset.n = n; const target = box.querySelector('[data-step=&quot;' + n + '&quot;]'); box.querySelectorAll('[data-step]').forEach((b) => b.classList.toggle('is-lit', b === target)); c.style.transform = 'translateX(' + Math.max(0, target.offsetLeft - 8) + 'px)'; c.style.setProperty('--arrow', Math.min(240, target.offsetWidth / 2 + 2) + 'px'); document.getElementById('cm-s').textContent = 'Langkah ' + (n + 1) + ' dari 3'; document.getElementById('cm-t').textContent = t[n][0]; document.getElementById('cm-b').textContent = t[n][1]; if (n === 2) this.textContent = 'Selesai';\">Lanjut</button>\n    </div>\n  </div>\n</div>",
        "code": "<div style=\"position: relative;\">\n  <button class=\"btn btn--secondary btn--md is-lit\" id=\"search-btn\">Cari</button>\n  <div class=\"coach\" role=\"dialog\" aria-labelledby=\"coach-t\" aria-describedby=\"coach-b\" style=\"top: 64px; left: 0; --arrow: 40px;\">\n    <div class=\"coach__step\">Langkah 1 dari 3</div>\n    <div class=\"coach__title\" id=\"coach-t\">Cari semua laporan</div>\n    <div class=\"coach__body\" id=\"coach-b\">Temukan laporan lewat kata apa pun di dalamnya, tidak hanya judulnya.</div>\n    <div class=\"cluster\" style=\"margin-top: 14px; justify-content: flex-end;\">\n      <button class=\"btn btn--sm\">Lewati</button>\n      <button class=\"btn btn--sm is-primary\">Lanjut</button>\n    </div>\n  </div>\n</div>"
      },
      {
        "title": "Satu penunjuk",
        "desc": "Satu langkah tidak perlu penghitung; satu-satunya aksi adalah \"Mengerti\".",
        "html": "<div style=\"position: relative; min-height: 210px;\">\n  <button class=\"btn btn--gray btn--md is-lit\"><span class=\"ic\" aria-hidden=\"true\">download</span>Ekspor</button>\n  <div class=\"coach\" role=\"dialog\" aria-labelledby=\"cm2-t\" style=\"top: 60px; left: 0; --arrow: 36px;\">\n    <div class=\"coach__title\" id=\"cm2-t\">Ekspor data retribusi ke spreadsheet</div>\n    <div class=\"coach__body\">Semua kolom yang Anda lihat ikut diekspor, dengan urutan yang sama.</div>\n    <div class=\"docs-row\" style=\"margin-top: 14px; justify-content: flex-end;\"><button class=\"btn btn--sm is-primary\" onclick=\"this.closest('.coach').hidden = true; this.closest('.coach').parentElement.querySelector('.is-lit').classList.remove('is-lit');\">Mengerti</button></div>\n  </div>\n</div>"
      }
    ]
