{
  "version": "0.1.2",
  "slug": "kbd",
  "title": "Keyboard key",
  "group": "Actions",
  "order": 11,
  "summary": {
    "en": "A small key cap that shows a keyboard shortcut: `.kbd` for one key, `.kbd-row` for a combination. Shortcuts are hints next to an action, never the only way to reach it.",
    "id": "Tutup tombol kecil yang menampilkan pintasan keyboard: `.kbd` untuk satu tombol, `.kbd-row` untuk kombinasi. Pintasan adalah petunjuk di samping aksi, tidak pernah satu-satunya cara mencapainya."
  },
  "titleId": "Keyboard key",
  "react": false,
  "examples": {
    "en": [
      {
        "title": "Keys and combinations",
        "desc": "Use the symbols people see on their keyboard; spell out keys that have no common symbol (esc, tab).",
        "html": "<div class=\"docs-row\" style=\"gap: 28px;\">\n  <span class=\"kbd-row\"><kbd class=\"kbd\">⌘</kbd><kbd class=\"kbd\">K</kbd></span>\n  <span class=\"kbd-row\"><kbd class=\"kbd\">⇧</kbd><kbd class=\"kbd\">⌘</kbd><kbd class=\"kbd\">P</kbd></span>\n  <kbd class=\"kbd\">esc</kbd>\n  <span class=\"kbd-row\"><kbd class=\"kbd\">↑</kbd><kbd class=\"kbd\">↓</kbd><span class=\"docs-note\" style=\"margin-left: 6px;\">to move</span></span>\n  <span class=\"kbd-row\"><kbd class=\"kbd\">↵</kbd><span class=\"docs-note\" style=\"margin-left: 6px;\">to open</span></span>\n</div>"
      },
      {
        "title": "In a tooltip and a sentence",
        "desc": "Inside a tooltip the key adapts to the dark surface by itself.",
        "html": "<div class=\"docs-row\" style=\"gap: 24px;\">\n  <span class=\"tip-host\"><button class=\"icon-btn icon-btn--filled\" aria-label=\"Search\" aria-keyshortcuts=\"Meta+K\"><span class=\"ic\" aria-hidden=\"true\">search</span></button><span class=\"tip\" role=\"tooltip\">Search<span class=\"kbd\">⌘K</span></span></span>\n  <p class=\"card__sub\" style=\"margin: 0;\">Press <kbd class=\"kbd\">/</kbd> anywhere to jump to the search field.</p>\n</div>"
      },
      {
        "title": "In a menu",
        "desc": "A `kbd-row` inside a menu item pushes to the right edge.",
        "html": "<div class=\"menu is-open\" role=\"menu\" aria-label=\"Edit\" style=\"position: relative;\">\n  <button class=\"menu__item\" role=\"menuitem\" aria-keyshortcuts=\"Meta+C\"><span class=\"ic\" aria-hidden=\"true\">content_copy</span>Copy link<span class=\"kbd-row\"><kbd class=\"kbd\">⌘</kbd><kbd class=\"kbd\">C</kbd></span></button>\n  <button class=\"menu__item\" role=\"menuitem\" aria-keyshortcuts=\"Meta+D\"><span class=\"ic\" aria-hidden=\"true\">edit_square</span>Duplicate<span class=\"kbd-row\"><kbd class=\"kbd\">⌘</kbd><kbd class=\"kbd\">D</kbd></span></button>\n</div>"
      }
    ],
    "id": [
      {
        "title": "Tombol dan kombinasi",
        "desc": "Pakai simbol yang terlihat di keyboard orang; tulis lengkap tombol yang tidak punya simbol umum (esc, tab).",
        "html": "<div class=\"docs-row\" style=\"gap: 28px;\">\n  <span class=\"kbd-row\"><kbd class=\"kbd\">⌘</kbd><kbd class=\"kbd\">K</kbd></span>\n  <span class=\"kbd-row\"><kbd class=\"kbd\">⇧</kbd><kbd class=\"kbd\">⌘</kbd><kbd class=\"kbd\">P</kbd></span>\n  <kbd class=\"kbd\">esc</kbd>\n  <span class=\"kbd-row\"><kbd class=\"kbd\">↑</kbd><kbd class=\"kbd\">↓</kbd><span class=\"docs-note\" style=\"margin-left: 6px;\">untuk berpindah</span></span>\n  <span class=\"kbd-row\"><kbd class=\"kbd\">↵</kbd><span class=\"docs-note\" style=\"margin-left: 6px;\">untuk membuka</span></span>\n</div>"
      },
      {
        "title": "Di tooltip dan kalimat",
        "desc": "Di dalam tooltip, tombol menyesuaikan diri dengan permukaan gelap.",
        "html": "<div class=\"docs-row\" style=\"gap: 24px;\">\n  <span class=\"tip-host\"><button class=\"icon-btn icon-btn--filled\" aria-label=\"Cari\" aria-keyshortcuts=\"Meta+K\"><span class=\"ic\" aria-hidden=\"true\">search</span></button><span class=\"tip\" role=\"tooltip\">Cari<span class=\"kbd\">⌘K</span></span></span>\n  <p class=\"card__sub\" style=\"margin: 0;\">Tekan <kbd class=\"kbd\">/</kbd> di mana saja untuk langsung ke kolom pencarian.</p>\n</div>"
      },
      {
        "title": "Di menu",
        "desc": "`kbd-row` di dalam item menu terdorong ke tepi kanan.",
        "html": "<div class=\"menu is-open\" role=\"menu\" aria-label=\"Sunting\" style=\"position: relative;\">\n  <button class=\"menu__item\" role=\"menuitem\" aria-keyshortcuts=\"Meta+C\"><span class=\"ic\" aria-hidden=\"true\">content_copy</span>Salin tautan<span class=\"kbd-row\"><kbd class=\"kbd\">⌘</kbd><kbd class=\"kbd\">C</kbd></span></button>\n  <button class=\"menu__item\" role=\"menuitem\" aria-keyshortcuts=\"Meta+D\"><span class=\"ic\" aria-hidden=\"true\">edit_square</span>Gandakan<span class=\"kbd-row\"><kbd class=\"kbd\">⌘</kbd><kbd class=\"kbd\">D</kbd></span></button>\n</div>"
      }
    ]
  },
