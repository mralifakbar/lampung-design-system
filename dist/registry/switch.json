{
  "version": "0.1.2",
  "slug": "switch",
  "title": "Switch",
  "group": "Selection",
  "order": 4,
  "summary": {
    "en": "An on and off control for a setting that applies the moment it is flipped, with no Save button. The thumb stretches while held and travels on a spring.",
    "id": "Kontrol nyala dan mati untuk pengaturan yang berlaku saat itu juga ketika diubah, tanpa tombol Simpan. Thumb meregang selama ditahan dan berpindah dengan spring."
  },
  "titleId": "Switch",
  "react": true,
  "examples": {
    "en": [
      {
        "title": "With an explanation",
        "desc": "Press and hold: the thumb widens toward where it will go, then travels on the smooth spring and stretches once as it lands.",
        "html": "<div class=\"stack\" style=\"--gap: 16px;\">\n  <label class=\"switch\"><input type=\"checkbox\" role=\"switch\" checked><span class=\"switch__track\" aria-hidden=\"true\"><span class=\"switch__thumb\"></span></span><span class=\"switch__text\">Service appointment reminders<small>15 minutes before your appointment</small></span></label>\n  <label class=\"switch\"><input type=\"checkbox\" role=\"switch\"><span class=\"switch__track\" aria-hidden=\"true\"><span class=\"switch__thumb\"></span></span><span class=\"switch__text\">Show the queue number on the lock screen<small>Hide it if you share your phone</small></span></label>\n  <label class=\"switch\"><input type=\"checkbox\" role=\"switch\" disabled><span class=\"switch__track\" aria-hidden=\"true\"><span class=\"switch__thumb\"></span></span><span class=\"switch__text\">Sync with the office calendar<small>Ask your agency admin to enable it</small></span></label>\n</div>"
      },
      {
        "title": "Settings rows on a phone",
        "desc": "The list row is the label, so tapping anywhere on it flips the small switch at the end.",
        "html": "<div class=\"list list--fill\" style=\"max-width: 380px; width: 100%;\">\n  <label class=\"lrow lrow--icon\"><span class=\"lrow__icon\" style=\"background: var(--tile-red);\"><span class=\"ic\" aria-hidden=\"true\">notifications</span></span><span class=\"lrow__body\"><span class=\"lrow__title\">Appointment reminders</span></span><span class=\"switch switch--sm\"><input type=\"checkbox\" role=\"switch\" checked><span class=\"switch__track\" aria-hidden=\"true\"><span class=\"switch__thumb\"></span></span></span></label>\n  <label class=\"lrow lrow--icon\"><span class=\"lrow__icon\" style=\"background: var(--tile-blue);\"><span class=\"ic\" aria-hidden=\"true\">touch_app</span></span><span class=\"lrow__body\"><span class=\"lrow__title\">Haptic feedback</span></span><span class=\"switch switch--sm\"><input type=\"checkbox\" role=\"switch\"><span class=\"switch__track\" aria-hidden=\"true\"><span class=\"switch__thumb\"></span></span></span></label>\n</div>"
      }
    ],
    "id": [
      {
        "title": "Dengan penjelasan",
        "desc": "Tekan dan tahan: thumb melebar ke arah tujuannya, lalu berpindah dengan spring halus dan meregang sekali saat mendarat.",
        "html": "<div class=\"stack\" style=\"--gap: 16px;\">\n  <label class=\"switch\"><input type=\"checkbox\" role=\"switch\" checked><span class=\"switch__track\" aria-hidden=\"true\"><span class=\"switch__thumb\"></span></span><span class=\"switch__text\">Pengingat jadwal layanan<small>15 menit sebelum jadwal kunjungan Anda</small></span></label>\n  <label class=\"switch\"><input type=\"checkbox\" role=\"switch\"><span class=\"switch__track\" aria-hidden=\"true\"><span class=\"switch__thumb\"></span></span><span class=\"switch__text\">Tampilkan nomor antrean di layar kunci<small>Sembunyikan jika Anda berbagi ponsel</small></span></label>\n  <label class=\"switch\"><input type=\"checkbox\" role=\"switch\" disabled><span class=\"switch__track\" aria-hidden=\"true\"><span class=\"switch__thumb\"></span></span><span class=\"switch__text\">Sinkronkan dengan kalender kantor<small>Minta admin dinas untuk mengaktifkannya</small></span></label>\n</div>"
      },
      {
        "title": "Baris pengaturan di ponsel",
        "desc": "Baris daftar adalah labelnya, jadi mengetuk di mana saja pada baris mengubah switch kecil di ujungnya.",
        "html": "<div class=\"list list--fill\" style=\"max-width: 380px; width: 100%;\">\n  <label class=\"lrow lrow--icon\"><span class=\"lrow__icon\" style=\"background: var(--tile-red);\"><span class=\"ic\" aria-hidden=\"true\">notifications</span></span><span class=\"lrow__body\"><span class=\"lrow__title\">Pengingat jadwal</span></span><span class=\"switch switch--sm\"><input type=\"checkbox\" role=\"switch\" checked><span class=\"switch__track\" aria-hidden=\"true\"><span class=\"switch__thumb\"></span></span></span></label>\n  <label class=\"lrow lrow--icon\"><span class=\"lrow__icon\" style=\"background: var(--tile-blue);\"><span class=\"ic\" aria-hidden=\"true\">touch_app</span></span><span class=\"lrow__body\"><span class=\"lrow__title\">Getar saat disentuh</span></span><span class=\"switch switch--sm\"><input type=\"checkbox\" role=\"switch\"><span class=\"switch__track\" aria-hidden=\"true\"><span class=\"switch__thumb\"></span></span></span></label>\n</div>"
      }
    ]
  },
  "reactUsage": "import { Switch } from 'lampung-design-system/react';\n\n<Switch checked={reminders} onChange={setReminders} sub=\"15 minutes before your appointment\">\n  Appointment reminders\n</Switch>\n<Switch size=\"sm\" checked={haptics} onChange={setHaptics}>Haptic feedback</Switch>",
  "related": [
    "checkbox",
    "segmented-control",
    "toggle",
    "list"
  ]
}
