{
  "version": "0.2.0",
  "slug": "progress-ring",
  "title": "Progress ring",
  "group": "Feedback",
  "order": 4,
  "summary": {
    "en": "A circular track with the value drawn as an arc and the number in the middle. For compact places and judged scores; say the judgment in words too.",
    "id": "Track melingkar dengan nilai digambar sebagai busur dan angka di tengah. Untuk tempat yang ringkas dan skor yang dinilai; sebutkan juga penilaiannya dengan kata-kata."
  },
  "titleId": "Progress ring",
  "react": true,
  "examples": {
    "en": [
      {
        "title": "Score with a verdict",
        "desc": "Service standard scores from a kelurahan office review. The color supports the words; it never replaces them.",
        "html": "<div class=\"docs-row\" style=\"gap: 28px;\">\n  <div class=\"docs-row\"><div class=\"ring ring--success\" role=\"img\" aria-label=\"Score 86 of 100, meets the standard\"><svg viewBox=\"0 0 64 64\" aria-hidden=\"true\"><circle class=\"ring__track\" cx=\"32\" cy=\"32\" r=\"27\"></circle><circle class=\"ring__val\" cx=\"32\" cy=\"32\" r=\"27\" stroke-dasharray=\"169.6\" stroke-dashoffset=\"23.7\"></circle></svg><span class=\"ring__label\" aria-hidden=\"true\">86</span></div><div><div class=\"card__title\">Meets the standard</div><div class=\"card__sub\">Threshold is 65</div></div></div>\n  <div class=\"docs-row\"><div class=\"ring ring--warning\" role=\"img\" aria-label=\"Score 62 of 100, just below the threshold\"><svg viewBox=\"0 0 64 64\" aria-hidden=\"true\"><circle class=\"ring__track\" cx=\"32\" cy=\"32\" r=\"27\"></circle><circle class=\"ring__val\" cx=\"32\" cy=\"32\" r=\"27\" stroke-dasharray=\"169.6\" stroke-dashoffset=\"64.4\"></circle></svg><span class=\"ring__label\" aria-hidden=\"true\">62</span></div><div><div class=\"card__title\">Just below</div><div class=\"card__sub\">3 points short</div></div></div>\n  <div class=\"docs-row\"><div class=\"ring ring--danger\" role=\"img\" aria-label=\"Score 38 of 100, does not meet the standard\"><svg viewBox=\"0 0 64 64\" aria-hidden=\"true\"><circle class=\"ring__track\" cx=\"32\" cy=\"32\" r=\"27\"></circle><circle class=\"ring__val\" cx=\"32\" cy=\"32\" r=\"27\" stroke-dasharray=\"169.6\" stroke-dashoffset=\"105.2\"></circle></svg><span class=\"ring__label\" aria-hidden=\"true\">38</span></div><div><div class=\"card__title\">Not met</div><div class=\"card__sub\">Reassessment on 2 December</div></div></div>\n</div>"
      },
      {
        "title": "Task progress that moves",
        "desc": "The arc eases to each new value. Press the button.",
        "html": "<div class=\"docs-row\" style=\"gap: 16px;\">\n  <div class=\"ring\" id=\"rg\" role=\"progressbar\" aria-label=\"Reports followed up this week\" aria-valuemin=\"0\" aria-valuemax=\"100\" aria-valuenow=\"40\"><svg viewBox=\"0 0 64 64\" aria-hidden=\"true\"><circle class=\"ring__track\" cx=\"32\" cy=\"32\" r=\"27\"></circle><circle class=\"ring__val\" cx=\"32\" cy=\"32\" r=\"27\" stroke-dasharray=\"169.6\" stroke-dashoffset=\"101.8\"></circle></svg><span class=\"ring__label\">40</span></div>\n  <button class=\"btn btn--secondary btn--sm\" onclick=\"const r = document.getElementById('rg'); const v = (Number(r.getAttribute('aria-valuenow')) + 25) % 125; r.setAttribute('aria-valuenow', v); r.querySelector('.ring__val').setAttribute('stroke-dashoffset', (169.6 * (1 - v / 100)).toFixed(1)); r.querySelector('.ring__label').textContent = v;\">Add progress</button>\n</div>",
        "code": "<div class=\"ring\" role=\"progressbar\" aria-label=\"Reports followed up this week\" aria-valuemin=\"0\" aria-valuemax=\"100\" aria-valuenow=\"40\">\n  <svg viewBox=\"0 0 64 64\" aria-hidden=\"true\">\n    <circle class=\"ring__track\" cx=\"32\" cy=\"32\" r=\"27\"></circle>\n    <circle class=\"ring__val\" cx=\"32\" cy=\"32\" r=\"27\" stroke-dasharray=\"169.6\" stroke-dashoffset=\"101.8\"></circle>\n  </svg>\n  <span class=\"ring__label\">40</span>\n</div>"
      },
      {
        "title": "Small, in a list row",
        "desc": "At 40 px set the size inline and shrink the label with it.",
        "html": "<div class=\"list\" style=\"max-width: 420px;\">\n  <div class=\"lrow\"><div class=\"ring\" style=\"width: 40px; height: 40px;\" role=\"img\" aria-label=\"75 percent done\"><svg viewBox=\"0 0 64 64\" aria-hidden=\"true\"><circle class=\"ring__track\" cx=\"32\" cy=\"32\" r=\"27\"></circle><circle class=\"ring__val\" cx=\"32\" cy=\"32\" r=\"27\" stroke-dasharray=\"169.6\" stroke-dashoffset=\"42.4\"></circle></svg><span class=\"ring__label\" style=\"font-size: 12px;\" aria-hidden=\"true\">75</span></div><div class=\"lrow__body\"><div class=\"lrow__title\">Aid recipient data check</div><div class=\"lrow__sub\">15 of 20 households</div></div></div>\n  <div class=\"lrow\"><div class=\"ring\" style=\"width: 40px; height: 40px;\" role=\"img\" aria-label=\"30 percent done\"><svg viewBox=\"0 0 64 64\" aria-hidden=\"true\"><circle class=\"ring__track\" cx=\"32\" cy=\"32\" r=\"27\"></circle><circle class=\"ring__val\" cx=\"32\" cy=\"32\" r=\"27\" stroke-dasharray=\"169.6\" stroke-dashoffset=\"118.7\"></circle></svg><span class=\"ring__label\" style=\"font-size: 12px;\" aria-hidden=\"true\">30</span></div><div class=\"lrow__body\"><div class=\"lrow__title\">Road damage survey, Kedaton</div><div class=\"lrow__sub\">6 of 20 sites</div></div></div>\n</div>"
      }
    ],
    "id": [
      {
        "title": "Skor dengan keputusan",
        "desc": "Skor standar layanan dari penilaian kantor kelurahan. Warna mendukung kata-kata; tidak pernah menggantikannya.",
        "html": "<div class=\"docs-row\" style=\"gap: 28px;\">\n  <div class=\"docs-row\"><div class=\"ring ring--success\" role=\"img\" aria-label=\"Skor 86 dari 100, memenuhi standar\"><svg viewBox=\"0 0 64 64\" aria-hidden=\"true\"><circle class=\"ring__track\" cx=\"32\" cy=\"32\" r=\"27\"></circle><circle class=\"ring__val\" cx=\"32\" cy=\"32\" r=\"27\" stroke-dasharray=\"169.6\" stroke-dashoffset=\"23.7\"></circle></svg><span class=\"ring__label\" aria-hidden=\"true\">86</span></div><div><div class=\"card__title\">Memenuhi standar</div><div class=\"card__sub\">Batas minimal 65</div></div></div>\n  <div class=\"docs-row\"><div class=\"ring ring--warning\" role=\"img\" aria-label=\"Skor 62 dari 100, sedikit di bawah batas minimal\"><svg viewBox=\"0 0 64 64\" aria-hidden=\"true\"><circle class=\"ring__track\" cx=\"32\" cy=\"32\" r=\"27\"></circle><circle class=\"ring__val\" cx=\"32\" cy=\"32\" r=\"27\" stroke-dasharray=\"169.6\" stroke-dashoffset=\"64.4\"></circle></svg><span class=\"ring__label\" aria-hidden=\"true\">62</span></div><div><div class=\"card__title\">Sedikit di bawah</div><div class=\"card__sub\">Kurang 3 poin</div></div></div>\n  <div class=\"docs-row\"><div class=\"ring ring--danger\" role=\"img\" aria-label=\"Skor 38 dari 100, belum memenuhi standar\"><svg viewBox=\"0 0 64 64\" aria-hidden=\"true\"><circle class=\"ring__track\" cx=\"32\" cy=\"32\" r=\"27\"></circle><circle class=\"ring__val\" cx=\"32\" cy=\"32\" r=\"27\" stroke-dasharray=\"169.6\" stroke-dashoffset=\"105.2\"></circle></svg><span class=\"ring__label\" aria-hidden=\"true\">38</span></div><div><div class=\"card__title\">Belum memenuhi</div><div class=\"card__sub\">Penilaian ulang 2 Desember</div></div></div>\n</div>"
      },
      {
        "title": "Kemajuan tugas yang bergerak",
        "desc": "Busur bergerak halus ke setiap nilai baru. Tekan tombolnya.",
        "html": "<div class=\"docs-row\" style=\"gap: 16px;\">\n  <div class=\"ring\" id=\"rg\" role=\"progressbar\" aria-label=\"Laporan ditindaklanjuti minggu ini\" aria-valuemin=\"0\" aria-valuemax=\"100\" aria-valuenow=\"40\"><svg viewBox=\"0 0 64 64\" aria-hidden=\"true\"><circle class=\"ring__track\" cx=\"32\" cy=\"32\" r=\"27\"></circle><circle class=\"ring__val\" cx=\"32\" cy=\"32\" r=\"27\" stroke-dasharray=\"169.6\" stroke-dashoffset=\"101.8\"></circle></svg><span class=\"ring__label\">40</span></div>\n  <button class=\"btn btn--secondary btn--sm\" onclick=\"const r = document.getElementById('rg'); const v = (Number(r.getAttribute('aria-valuenow')) + 25) % 125; r.setAttribute('aria-valuenow', v); r.querySelector('.ring__val').setAttribute('stroke-dashoffset', (169.6 * (1 - v / 100)).toFixed(1)); r.querySelector('.ring__label').textContent = v;\">Tambah kemajuan</button>\n</div>",
        "code": "<div class=\"ring\" role=\"progressbar\" aria-label=\"Laporan ditindaklanjuti minggu ini\" aria-valuemin=\"0\" aria-valuemax=\"100\" aria-valuenow=\"40\">\n  <svg viewBox=\"0 0 64 64\" aria-hidden=\"true\">\n    <circle class=\"ring__track\" cx=\"32\" cy=\"32\" r=\"27\"></circle>\n    <circle class=\"ring__val\" cx=\"32\" cy=\"32\" r=\"27\" stroke-dasharray=\"169.6\" stroke-dashoffset=\"101.8\"></circle>\n  </svg>\n  <span class=\"ring__label\">40</span>\n</div>"
      },
      {
        "title": "Kecil, di baris list",
        "desc": "Pada 40 px, atur ukurannya secara inline dan kecilkan labelnya juga.",
        "html": "<div class=\"list\" style=\"max-width: 420px;\">\n  <div class=\"lrow\"><div class=\"ring\" style=\"width: 40px; height: 40px;\" role=\"img\" aria-label=\"75 persen selesai\"><svg viewBox=\"0 0 64 64\" aria-hidden=\"true\"><circle class=\"ring__track\" cx=\"32\" cy=\"32\" r=\"27\"></circle><circle class=\"ring__val\" cx=\"32\" cy=\"32\" r=\"27\" stroke-dasharray=\"169.6\" stroke-dashoffset=\"42.4\"></circle></svg><span class=\"ring__label\" style=\"font-size: 12px;\" aria-hidden=\"true\">75</span></div><div class=\"lrow__body\"><div class=\"lrow__title\">Verifikasi data penerima bansos</div><div class=\"lrow__sub\">15 dari 20 KK</div></div></div>\n  <div class=\"lrow\"><div class=\"ring\" style=\"width: 40px; height: 40px;\" role=\"img\" aria-label=\"30 persen selesai\"><svg viewBox=\"0 0 64 64\" aria-hidden=\"true\"><circle class=\"ring__track\" cx=\"32\" cy=\"32\" r=\"27\"></circle><circle class=\"ring__val\" cx=\"32\" cy=\"32\" r=\"27\" stroke-dasharray=\"169.6\" stroke-dashoffset=\"118.7\"></circle></svg><span class=\"ring__label\" style=\"font-size: 12px;\" aria-hidden=\"true\">30</span></div><div class=\"lrow__body\"><div class=\"lrow__title\">Survei jalan rusak Kedaton</div><div class=\"lrow__sub\">6 dari 20 titik</div></div></div>\n</div>"
      }
    ]
  },
  "reactUsage": "import { Ring } from 'lampung-design-system/react';\n\n<Ring value={86} tone=\"success\" ariaLabel=\"Score 86 of 100, meets the standard\" />\n<Ring value={12} max={20} size={44} label=\"12\" ariaLabel=\"12 of 20 households checked\" />",
