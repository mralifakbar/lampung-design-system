{
  "version": "0.1.0",
  "slug": "steps",
  "title": "Steps",
  "group": "Navigation",
  "order": 7,
  "summary": {
    "en": "Numbered steps of a fixed sequence with a bar that fills as each one completes. Shows where people are in a flow and how much is left.",
    "id": "Langkah bernomor dari urutan tetap dengan bilah yang terisi saat setiap langkah selesai. Menunjukkan posisi orang dalam sebuah alur dan berapa yang tersisa."
  },
  "titleId": "Steps",
  "react": true,
  "examples": {
    "en": [
      {
        "title": "Business permit application",
        "desc": "Step 2 of 4. Press Continue to complete a step: the bar fills, then the dot turns to a check.",
        "html": "<div class=\"stack\" style=\"--gap: 24px;\">\n  <ol class=\"steps\" aria-label=\"Application progress\" id=\"st-demo\">\n    <li class=\"step is-done\"><div class=\"step__head\"><span class=\"step__dot\"><span class=\"ic\" aria-hidden=\"true\">check</span></span><span class=\"step__bar\"></span></div><span class=\"step__label\">Personal details</span><span class=\"step__sub\">Name and contact</span></li>\n    <li class=\"step is-current\" aria-current=\"step\"><div class=\"step__head\"><span class=\"step__dot\">2</span><span class=\"step__bar\"></span></div><span class=\"step__label\">Business</span><span class=\"step__sub\">Type and location</span></li>\n    <li class=\"step\"><div class=\"step__head\"><span class=\"step__dot\">3</span><span class=\"step__bar\"></span></div><span class=\"step__label\">Payment</span><span class=\"step__sub\">Levy and fees</span></li>\n    <li class=\"step\"><div class=\"step__head\"><span class=\"step__dot\">4</span></div><span class=\"step__label\">Review</span><span class=\"step__sub\">Check and submit</span></li>\n  </ol>\n  <div class=\"cluster\">\n    <button class=\"btn btn--primary btn--md\" onclick=\"const c = document.querySelector('#st-demo .is-current'); if (!c) return; c.classList.replace('is-current', 'is-done'); c.removeAttribute('aria-current'); c.querySelector('.step__dot').innerHTML = '&lt;span class=&quot;ic&quot; aria-hidden=&quot;true&quot;&gt;check&lt;/span&gt;'; const n = c.nextElementSibling; if (n) { n.classList.add('is-current'); n.setAttribute('aria-current', 'step'); }\">Continue</button>\n  </div>\n</div>",
        "code": "<ol class=\"steps\" aria-label=\"Application progress\">\n  <li class=\"step is-done\">\n    <div class=\"step__head\"><span class=\"step__dot\"><span class=\"ic\" aria-hidden=\"true\">check</span></span><span class=\"step__bar\"></span></div>\n    <span class=\"step__label\">Personal details</span><span class=\"step__sub\">Name and contact</span>\n  </li>\n  <li class=\"step is-current\" aria-current=\"step\">\n    <div class=\"step__head\"><span class=\"step__dot\">2</span><span class=\"step__bar\"></span></div>\n    <span class=\"step__label\">Business</span><span class=\"step__sub\">Type and location</span>\n  </li>\n  <li class=\"step\">\n    <div class=\"step__head\"><span class=\"step__dot\">3</span></div>\n    <span class=\"step__label\">Payment</span><span class=\"step__sub\">Levy and fees</span>\n  </li>\n</ol>"
      },
      {
        "title": "Labels only",
        "desc": "Three short steps without a second line.",
        "html": "<ol class=\"steps\" aria-label=\"Publishing an announcement\">\n  <li class=\"step is-done\"><div class=\"step__head\"><span class=\"step__dot\"><span class=\"ic\" aria-hidden=\"true\">check</span></span><span class=\"step__bar\"></span></div><span class=\"step__label\">Content</span></li>\n  <li class=\"step is-done\"><div class=\"step__head\"><span class=\"step__dot\"><span class=\"ic\" aria-hidden=\"true\">check</span></span><span class=\"step__bar\"></span></div><span class=\"step__label\">Schedule</span></li>\n  <li class=\"step is-current\" aria-current=\"step\"><div class=\"step__head\"><span class=\"step__dot\">3</span></div><span class=\"step__label\">Publish</span></li>\n</ol>"
      }
    ],
    "id": [
      {
        "title": "Permohonan izin usaha",
        "desc": "Langkah 2 dari 4. Tekan Lanjutkan untuk menyelesaikan langkah: bilah terisi, lalu titik berubah menjadi centang.",
        "html": "<div class=\"stack\" style=\"--gap: 24px;\">\n  <ol class=\"steps\" aria-label=\"Kemajuan permohonan\" id=\"st-demo\">\n    <li class=\"step is-done\"><div class=\"step__head\"><span class=\"step__dot\"><span class=\"ic\" aria-hidden=\"true\">check</span></span><span class=\"step__bar\"></span></div><span class=\"step__label\">Data diri</span><span class=\"step__sub\">Nama dan kontak</span></li>\n    <li class=\"step is-current\" aria-current=\"step\"><div class=\"step__head\"><span class=\"step__dot\">2</span><span class=\"step__bar\"></span></div><span class=\"step__label\">Data usaha</span><span class=\"step__sub\">Jenis dan lokasi usaha</span></li>\n    <li class=\"step\"><div class=\"step__head\"><span class=\"step__dot\">3</span><span class=\"step__bar\"></span></div><span class=\"step__label\">Pembayaran</span><span class=\"step__sub\">Retribusi dan biaya</span></li>\n    <li class=\"step\"><div class=\"step__head\"><span class=\"step__dot\">4</span></div><span class=\"step__label\">Tinjau</span><span class=\"step__sub\">Periksa dan kirim</span></li>\n  </ol>\n  <div class=\"cluster\">\n    <button class=\"btn btn--primary btn--md\" onclick=\"const c = document.querySelector('#st-demo .is-current'); if (!c) return; c.classList.replace('is-current', 'is-done'); c.removeAttribute('aria-current'); c.querySelector('.step__dot').innerHTML = '&lt;span class=&quot;ic&quot; aria-hidden=&quot;true&quot;&gt;check&lt;/span&gt;'; const n = c.nextElementSibling; if (n) { n.classList.add('is-current'); n.setAttribute('aria-current', 'step'); }\">Lanjutkan</button>\n  </div>\n</div>",
        "code": "<ol class=\"steps\" aria-label=\"Kemajuan permohonan\">\n  <li class=\"step is-done\">\n    <div class=\"step__head\"><span class=\"step__dot\"><span class=\"ic\" aria-hidden=\"true\">check</span></span><span class=\"step__bar\"></span></div>\n    <span class=\"step__label\">Data diri</span><span class=\"step__sub\">Nama dan kontak</span>\n  </li>\n  <li class=\"step is-current\" aria-current=\"step\">\n    <div class=\"step__head\"><span class=\"step__dot\">2</span><span class=\"step__bar\"></span></div>\n    <span class=\"step__label\">Data usaha</span><span class=\"step__sub\">Jenis dan lokasi usaha</span>\n  </li>\n  <li class=\"step\">\n    <div class=\"step__head\"><span class=\"step__dot\">3</span></div>\n    <span class=\"step__label\">Pembayaran</span><span class=\"step__sub\">Retribusi dan biaya</span>\n  </li>\n</ol>"
      },
      {
        "title": "Hanya label",
        "desc": "Tiga langkah pendek tanpa baris kedua.",
        "html": "<ol class=\"steps\" aria-label=\"Penerbitan pengumuman\">\n  <li class=\"step is-done\"><div class=\"step__head\"><span class=\"step__dot\"><span class=\"ic\" aria-hidden=\"true\">check</span></span><span class=\"step__bar\"></span></div><span class=\"step__label\">Isi</span></li>\n  <li class=\"step is-done\"><div class=\"step__head\"><span class=\"step__dot\"><span class=\"ic\" aria-hidden=\"true\">check</span></span><span class=\"step__bar\"></span></div><span class=\"step__label\">Jadwal</span></li>\n  <li class=\"step is-current\" aria-current=\"step\"><div class=\"step__head\"><span class=\"step__dot\">3</span></div><span class=\"step__label\">Terbitkan</span></li>\n</ol>"
      }
    ]
  },
  "reactUsage": "import { Steps } from 'lampung-design-system/react';\n\n<Steps label=\"Application progress\" current={1} items={['Personal details', 'Business', 'Payment', 'Review']} />",
  "related": [
    "progress-bar",
    "tabs",
    "list",
    "form-layout"
  ]
}
