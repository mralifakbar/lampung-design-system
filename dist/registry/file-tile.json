5 7.4 L5.7 10.4 L11.5 3.8\"></path><path class=\"dash\" d=\"M3 7 L11 7\"></path></svg></span></label>\n    <a class=\"file-tile__open\" href=\"#ft-6\"><span class=\"file-tile__thumb\"><span class=\"ic\" aria-hidden=\"true\">movie</span></span><span class=\"file-tile__name\">Onboarding walkthrough.mp4</span><span class=\"file-tile__meta\">86 MB · 9 Nov</span></a>\n    <button class=\"icon-btn file-tile__more\" aria-label=\"More actions for Onboarding walkthrough.mp4\" aria-haspopup=\"menu\" aria-expanded=\"false\" data-lds-menu=\"ft-m-6\"><span class=\"ic\" aria-hidden=\"true\">more_horiz</span></button>\n    <div class=\"menu menu--right\" id=\"ft-m-6\" role=\"menu\" aria-label=\"Onboarding walkthrough.mp4\" style=\"top: 44px; right: 4px;\">\n      <button class=\"menu__item\" role=\"menuitem\"><span class=\"ic\" aria-hidden=\"true\">download</span>Download</button>\n      <button class=\"menu__item\" role=\"menuitem\"><span class=\"ic\" aria-hidden=\"true\">edit</span>Rename</button>\n      <div class=\"menu__sep\"></div>\n      <button class=\"menu__item menu__item--danger\" role=\"menuitem\"><span class=\"ic\" aria-hidden=\"true\">delete</span>Delete</button>\n    </div>\n  </div>\n  <div class=\"file-tile file-tile--archive\" role=\"listitem\">\n    <label class=\"check file-tile__check\"><input type=\"checkbox\" data-lds-select aria-label=\"Select Brand assets.zip\"><span class=\"check__box\" aria-hidden=\"true\"><svg viewBox=\"0 0 14 14\"><path class=\"tick\" d=\"M2.5 7.4 L5.7 10.4 L11.5 3.8\"></path><path class=\"dash\" d=\"M3 7 L11 7\"></path></svg></span></label>\n    <a class=\"file-tile__open\" href=\"#ft-7\"><span class=\"file-tile__thumb\"><span class=\"ic\" aria-hidden=\"true\">folder_zip</span></span><span class=\"file-tile__name\">Brand assets.zip</span><span class=\"file-tile__meta\">24 MB · 2 Nov</span></a>\n    <button class=\"icon-btn file-tile__more\" aria-label=\"More actions for Brand assets.zip\" aria-haspopup=\"menu\" aria-expanded=\"false\"